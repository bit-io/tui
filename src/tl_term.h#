pub fn write_raw(s: string) is
    __builtin_io_write_no_nl(s)
end

;;@internal
pub fn flush_out() is
    __builtin_io_flush()
end

;; Terminal width in columns (best-effort; falls back to 80 if it can't be
;; determined, e.g. when stdout isn't a real tty).
pub fn term_width() -> int is
    let out: string = tl_text::trim_str(__builtin_process_run("stty size -F /dev/tty 2>/dev/null"))
    if out == "" is return 80 end
    let parts: [string] = str_split(out, " ")
    if parts.len() < 2 is return 80 end
    let w: int = __builtin_conv_str_to_int(parts[1])
    if w <= 0 is return 80 end
    return w
end

;; Terminal height in rows (best-effort; falls back to 24).
pub fn term_height() -> int is
    let out: string = tl_text::trim_str(__builtin_process_run("stty size -F /dev/tty 2>/dev/null"))
    if out == "" is return 24 end
    let parts: [string] = str_split(out, " ")
    if parts.len() < 1 is return 24 end
    let h: int = __builtin_conv_str_to_int(parts[0])
    if h <= 0 is return 24 end
    return h
end

;; (width, height) in one call — one `stty` shell-out instead of two.
pub fn term_size() -> (int, int) is
    let out: string = tl_text::trim_str(__builtin_process_run("stty size -F /dev/tty 2>/dev/null"))
    if out == "" is return (80, 24) end
    let parts: [string] = str_split(out, " ")
    if parts.len() < 2 is return (80, 24) end
    let h: int = __builtin_conv_str_to_int(parts[0])
    let w: int = __builtin_conv_str_to_int(parts[1])
    if w <= 0 is return (80, 24) end
    if h <= 0 is return (80, 24) end
    return (w, h)
end

;; (width, height) with as little work as possible: ONE `stty` shell-out and no
;; trimming helpers. Unlike `term_size` it does NOT invent 80x24 when the read
;; fails — it returns (0, 0) so a polling caller can keep its previous size
;; instead of "resizing" on a hiccup. Meant for polling every few hundred ms.
pub fn term_size_fast() -> (int, int) is
    let out: string = __builtin_process_run("stty size -F /dev/tty 2>/dev/null")
    let parts: [string] = str_split(out, " ")
    if parts.len() < 2 is return (0, 0) end
    let h: int = __builtin_conv_str_to_int(tl_text::trim_str(parts[0]))
    let w: int = __builtin_conv_str_to_int(tl_text::trim_str(parts[1]))
    if w <= 0 || h <= 0 is return (0, 0) end
    return (w, h)
end

;; Put the terminal into raw mode: no line buffering, no local echo, and a
;; ~100ms read timeout (`min 0 time 1`) so a single key-read never blocks
;; the render loop for long — this is what gives `poll_key` its "is a key
;; available right now" polling behaviour. `opost onlcr` is re-enabled on top
;; of `raw` so this program's own "\n" bytes still come out as "\r\n".
;;
;; Returns the terminal's previous settings (from `stty -g`) — hang on to
;; this and pass it to `disable_raw_mode` to restore the user's shell
;; exactly as it was, rather than guessing with `stty sane`.
pub fn enable_raw_mode() -> string is
    let saved: string = tl_text::trim_str(__builtin_process_run("stty -g -F /dev/tty 2>/dev/null"))
    let _r: string = __builtin_process_run("stty raw -echo min 0 time 1 opost onlcr -F /dev/tty 2>/dev/null")
    return saved
end

;; Restore whatever `enable_raw_mode` returned. Falls back to `stty sane`
;; if `saved` is empty (e.g. stdout wasn't a real tty to begin with).
pub fn disable_raw_mode(saved: string) is
    if saved != "" is
        let _r: string = __builtin_process_run("stty '" + saved + "' -F /dev/tty 2>/dev/null")
    else is
        let _r2: string = __builtin_process_run("stty sane -F /dev/tty 2>/dev/null")
    end
end

pub fn enter_alt_screen() is
    write_raw("\x1b[?1049h")
end

pub fn exit_alt_screen() is
    write_raw("\x1b[?1049l")
end

pub fn hide_cursor() is
    write_raw("\x1b[?25l")
end

pub fn show_cursor() is
    write_raw("\x1b[?25h")
end

pub fn clear_screen() is
    write_raw("\x1b[2J\x1b[H")
end

;; Erase the whole current line (cursor stays where it is).
pub fn clear_line() is
    write_raw("\x1b[2K")
end

pub fn move_home() is
    write_raw("\x1b[H")
end

pub fn move_to(row: int, col: int) is
    write_raw("\x1b[" + to_string(row) + ";" + to_string(col) + "H")
end

pub fn cursor_up(n: int) is
    if n > 0 is write_raw("\x1b[" + to_string(n) + "A") end
end

pub fn cursor_down(n: int) is
    if n > 0 is write_raw("\x1b[" + to_string(n) + "B") end
end

pub fn cursor_forward(n: int) is
    if n > 0 is write_raw("\x1b[" + to_string(n) + "C") end
end

pub fn cursor_back(n: int) is
    if n > 0 is write_raw("\x1b[" + to_string(n) + "D") end
end

pub fn save_cursor() is
    write_raw("\x1b7")
end

pub fn restore_cursor() is
    write_raw("\x1b8")
end

pub fn bell() is
    write_raw("\x07")
end

pub fn set_title(title: string) is
    write_raw("\x1b]0;" + title + "\x07")
end

;; Turn on mouse reporting (button press/release/drag + wheel, SGR encoding).
;; Events then arrive from `poll_key` as "mouse:<button>:<action>:<x>:<y>" and
;; from `run` as mouse messages (see `msg_is_mouse`).
pub fn enable_mouse() is
    write_raw("\x1b[?1000h\x1b[?1002h\x1b[?1006h")
end

pub fn disable_mouse() is
    write_raw("\x1b[?1006l\x1b[?1002l\x1b[?1000l")
end

;; Write a full frame: cursor home + clear + the given text, flushed immediately.
;; Used internally by `run`, exposed for callers rolling their own loop.
pub fn draw(frame: string) is
    write_raw("\x1b[H\x1b[2J")
    write_raw(frame)
    flush_out()
end
