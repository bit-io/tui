struct Style is
    pub fg: string
    pub bg: string
    pub bold: bool
    pub italic: bool
    pub underline: bool
    pub faint: bool
    pub strike: bool
    pub reverse: bool
    pub width: int          ;; 0 = auto (fit content)
    pub height: int          ;; 0 = auto; otherwise content is padded/cut to this many lines
    pub max_width: int          ;; 0 = unlimited; longer lines are cut with a trailing ellipsis
    pub align: string          ;; "left" | "center" | "right"
    pub valign: string          ;; "top" | "middle" | "bottom" (only matters with a fixed height)
    pub pad_x: int
    pub pad_y: int
    pub margin_x: int
    pub margin_y: int
    pub border: string          ;; "none" | "normal" | "rounded" | "thick" | "double" | "ascii" | "hidden"
    pub border_color: string
    pub wrap: bool          ;; word-wrap to `width` (needs width > 0)
end

pub fn style_new() -> any is
    return Style {
        fg: "", bg: "", bold: false,
        italic: false, underline: false, faint: false,
        strike: false, reverse: false, width: 0,
        height: 0, max_width: 0, align: "left",
        valign: "top", pad_x: 0, pad_y: 0,
        margin_x: 0, margin_y: 0, border: "none",
        border_color: "", wrap: false
    }
end

