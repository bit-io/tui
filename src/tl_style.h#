    let s: Style = s_any
    return Style {
        fg: color, bg: s.bg, bold: s.bold, italic: s.italic,
        underline: s.underline, faint: s.faint, strike: s.strike, reverse: s.reverse,
        width: s.width, height: s.height, max_width: s.max_width, align: s.align,
