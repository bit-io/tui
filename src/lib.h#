;; -- tl_text -----------------------------------------------------

pub fn trim_str(s: string) -> string is
    return tl_text::trim_str(s)
end

pub fn rep_str(s: string, n: int) -> string is
    return tl_text::rep_str(s, n)
end

pub fn pad_right(s: string, width: int) -> string is
    return tl_text::pad_right(s, width)
end

pub fn pad_left(s: string, width: int) -> string is
    return tl_text::pad_left(s, width)
end

pub fn pad_center(s: string, width: int) -> string is
    return tl_text::pad_center(s, width)
end

;; Strip ANSI SGR escape sequences ("\x1b[...m") so width/padding math is
;; done against what actually shows up on screen, not the byte count.
pub fn strip_ansi(s: string) -> string is
    return tl_text::strip_ansi(s)
end

;; Display width of `s`: ANSI escapes ignored, UTF-8 code points counted.
pub fn visible_len(s: string) -> int is
    return tl_text::visible_len(s)
end

;; The first `n` characters of `s` (UTF-8 aware; does not understand ANSI).
pub fn utf8_take(s: string, n: int) -> string is
    return tl_text::utf8_take(s, n)
end

;; `s` without its first `n` characters (UTF-8 aware; does not understand ANSI).
pub fn utf8_skip(s: string, n: int) -> string is
    return tl_text::utf8_skip(s, n)
end

;; Split `s` into its characters (one string per code point).
pub fn utf8_chars(s: string) -> [string] is
    return tl_text::utf8_chars(s)
end

;; Cut `s` to at most `width` columns, appending `tail` (e.g. "…") when something
;; was cut. ANSI escapes are kept (and a reset is appended) but never counted.
pub fn truncate_str(s: string, width: int, tail: string) -> string is
    return tl_text::truncate_str(s, width, tail)
end

;; Greedy word wrap to `width` columns. Words longer than a whole line are cut
;; hard. Plain text only — a wrapped line never carries styling across lines.
pub fn wrap_text(s: string, width: int) -> string is
    return tl_text::wrap_text(s, width)
end

;; ASCII-only lowercase (used for case-insensitive filtering).
pub fn lower_ascii(s: string) -> string is
    return tl_text::lower_ascii(s)
end

;; True when `needle` occurs in `hay` (case-sensitive; empty needle always matches).
pub fn contains_text(hay: string, needle: string) -> bool is
    return tl_text::contains_text(hay, needle)
end

;; True when `s` starts with `prefix`.
pub fn starts_with_text(s: string, prefix: string) -> bool is
    return tl_text::starts_with_text(s, prefix)
end

;; -- tl_term -----------------------------------------------------

;; Terminal width in columns (best-effort; falls back to 80 if it can't be
;; determined, e.g. when stdout isn't a real tty).
pub fn term_width() -> int is
    return tl_term::term_width()
end

;; Terminal height in rows (best-effort; falls back to 24).
pub fn term_height() -> int is
    return tl_term::term_height()
end

;; (width, height) in one call — one `stty` shell-out instead of two.
pub fn term_size() -> (int, int) is
    return tl_term::term_size()
end

;; Like `term_size`, but cheaper per call; returns (0, 0) when the size can't be
;; read (instead of guessing 80x24) so polling callers can keep their old size.
pub fn term_size_fast() -> (int, int) is
    return tl_term::term_size_fast()
end

;; Put the terminal into raw mode: no line buffering, no local echo, and a
;; ~100ms read timeout (`min 0 time 1`) so a single key-read never blocks
;; the render loop for long — this is what gives `poll_key` its "is a key
;; available right now" polling behaviour. `opost onlcr` is re-enabled on top
;; of `raw` so this program's own "\n" bytes still come out as "\r\n".
;;
;; Returns the terminal's previous settings (from `stty -g`) — hang on to
;; this and pass it to `disable_raw_mode` to restore the user's shell
;; exactly as it was, rather than guessing with `stty sane`.
pub fn enable_raw_mode() -> string is
    return tl_term::enable_raw_mode()
end

;; Restore whatever `enable_raw_mode` returned. Falls back to `stty sane`
;; if `saved` is empty (e.g. stdout wasn't a real tty to begin with).
pub fn disable_raw_mode(saved: string) is
    tl_term::disable_raw_mode(saved)
end

